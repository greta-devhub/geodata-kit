{
 "description": "Polygon timezone lookups (geodata-kit-tz, ODbL data).",
 "cases": [
  {
   "fn": "getTimezoneAt",
   "args": [
    39.77,
    -86.16
   ],
   "expect": "America/Indiana/Indianapolis"
  },
  {
   "fn": "getTimezoneAt",
   "args": [
    48.137,
    11.575
   ],
   "expect": "Europe/Berlin"
  },
  {
   "fn": "getTimezoneAt",
   "args": [
    47.3769,
    8.5417
   ],
   "expect": "Europe/Zurich",
