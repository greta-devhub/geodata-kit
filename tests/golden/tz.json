  },
  {
   "fn": "getTimezoneAt",
   "args": [
    41.15,
    -8.61
   ],
   "expect": "Europe/Lisbon",
   "note": "Porto, Portugal"
  },
  {
   "fn": "getTimezoneAt",
   "args": [
    42.6629,
    21.1655
   ],
   "expect": "Europe/Belgrade",
   "note": "Pristina"
  },
  {
   "fn": "getTimezoneAt",
   "args": [
    43.82,
