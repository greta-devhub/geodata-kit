{
  "name": "geodata-kit",
  "version": "0.4.1",
  "description": "Countries for TypeScript and JavaScript: names in 8 languages, free-text resolution, search, groups (EU, DACH, …), languages, timezones, currencies and more. Offline, typed, no dependencies. Core of the geodata-kit family.",
  "keywords": [
    "countries",
    "country",
    "iso-3166",
    "country-codes",
    "country-names",
    "languages",
    "timezone",
    "currency",
    "geo"
  ],
  "license": "MIT AND CC-BY-4.0 AND Unicode-3.0 AND Apache-2.0",
  "author": "geodata-kit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greta-devhub/geodata-kit.git",
    "directory": "packages/geodata-kit"
  },
  "homepage": "https://github.com/greta-devhub/geodata-kit/tree/main/packages/geodata-kit#readme",
  "bugs": {
    "url": "https://github.com/greta-devhub/geodata-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  }
}
