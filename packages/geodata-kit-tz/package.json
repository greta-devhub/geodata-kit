{
  "name": "geodata-kit-tz",
  "version": "0.4.1",
  "description": "Optional companion to geodata-kit: exact IANA timezone for any coordinate from timezone polygons. Code MIT, data ODbL 1.0.",
  "keywords": [
    "timezone",
    "tz",
    "iana",
    "coordinates",
    "point-in-polygon",
    "geodata-kit"
  ],
  "license": "MIT AND ODbL-1.0",
  "author": "geodata-kit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greta-devhub/geodata-kit.git",
    "directory": "packages/geodata-kit-tz"
  },
  "homepage": "https://github.com/greta-devhub/geodata-kit/tree/main/packages/geodata-kit-tz#readme",
  "bugs": {
    "url": "https://github.com/greta-devhub/geodata-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "NOTICE",
    "LICENSE",
    "LICENSE-DATA",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  }
}
