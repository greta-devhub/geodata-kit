{
  "name": "geodata-kit-airports",
  "version": "0.4.1",
  "description": "10,500 airports by IATA or ICAO code, with country, coordinates, timezone and the city they serve. Offline add-on for geodata-kit.",
  "keywords": [
    "airports",
    "iata",
    "icao",
    "airport-codes",
    "geodata-kit"
  ],
  "license": "MIT AND CC-BY-4.0",
  "author": "geodata-kit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greta-devhub/geodata-kit.git",
    "directory": "packages/geodata-kit-airports"
  },
  "homepage": "https://github.com/greta-devhub/geodata-kit/tree/main/packages/geodata-kit-airports#readme",
  "bugs": {
    "url": "https://github.com/greta-devhub/geodata-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "NOTICE",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "geodata-kit": "^0.4.1"
  },
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  }
}
