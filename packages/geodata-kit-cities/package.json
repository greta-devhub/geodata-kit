{
  "name": "geodata-kit-cities",
  "version": "0.4.0",
  "description": "237,000 cities for every country: find by name in many languages and scripts, parse free-text locations and get the IANA timezone of a city. Offline add-on for geodata-kit.",
  "keywords": [
    "cities",
    "city",
    "timezone",
    "city-timezone",
    "location",
    "geocoding",
    "geodata-kit"
  ],
  "license": "MIT AND CC-BY-4.0",
  "author": "geodata-kit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greta-devhub/geodata-kit.git",
    "directory": "packages/geodata-kit-cities"
  },
  "homepage": "https://github.com/greta-devhub/geodata-kit/tree/main/packages/geodata-kit-cities#readme",
  "bugs": {
    "url": "https://github.com/greta-devhub/geodata-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "NOTICE",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "geodata-kit": "^0.4.0",
    "geodata-kit-subdivisions": "^0.4.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  }
}
