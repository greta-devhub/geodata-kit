{
  "name": "geodata-kit-repo",
  "private": true,
  "type": "module",
  "description": "Monorepo for geodata-kit: countries, subdivisions, cities, languages, timezones, address and phone data built from GeoNames, CLDR, IANA tzdata, Wikidata, Natural Earth and libphonenumber.",
  "workspaces": [
    "packages/geodata-kit",
    "packages/geodata-kit-subdivisions",
    "packages/geodata-kit-cities",
    "packages/geodata-kit-airports",
    "packages/geodata-kit-shapes",
    "packages/geodata-kit-address",
    "packages/geodata-kit-phone",
    "packages/geodata-kit-localities",
    "packages/geodata-kit-postal",
    "packages/geodata-kit-tz"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "download": "tsx scripts/download.ts",
    "generate": "node --max-old-space-size=6144 --import tsx scripts/generate.ts",
    "emit": "tsx scripts/emit.ts",
    "build": "npm run emit && npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "python:test": "cd python && uv run --extra dev pytest -q",
    "wikidata": "tsx scripts/wikidata.ts",
    "extract": "tsx scripts/extract.ts",
    "changeset": "changeset",
    "release:version": "changeset version && tsx scripts/release/sync-versions.ts && npm install --package-lock-only --no-audit --no-fund",
    "versions:check": "tsx scripts/release/sync-versions.ts --check",
    "release:check": "tsx scripts/release/check-release.ts",
    "release:publish-npm": "tsx scripts/release/publish-npm.ts",
    "changeset:require": "tsx scripts/release/require-changeset.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.0",
    "libphonenumber-js": "1.13.16",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
